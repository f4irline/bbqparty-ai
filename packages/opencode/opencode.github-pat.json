{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "compaction": {
      "prompt": "{file:./.opencode/prompts/compaction.txt}"
    },
    "sous-chef": {
      "description": "Research and planning agent for /bbq.pantry and /bbq.prep workflows",
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      },
      "prompt": "{file:./.opencode/prompts/sous-chef.txt}"
    },
    "pitmaster": {
      "description": "Implementation and review-fix agent for /bbq.fire and /bbq.taste workflows",
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "prompt": "{file:./.opencode/prompts/pitmaster.txt}"
    },
    "health-inspector": {
      "description": "Independent reviewer for BBQ research, plans, and implementations",
      "mode": "subagent",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git *": "allow"
        }
      },
      "prompt": "{file:./.opencode/prompts/health-inspector.txt}"
    }
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer {env:BBQ_LINEAR_API_KEY}"
      },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:BBQ_GITHUB_PAT}"
      },
      "enabled": true
    }
  }
}
