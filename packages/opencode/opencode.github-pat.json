{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "compaction": {
      "system": "{file:./.opencode/prompts/compaction.txt}"
    },
    "station": {
      "description": "Non-interactive branch resolver for Herdr worktree orchestration"
    },
    "sous-chef": {
      "description": "Research and planning agent for /bbq.pantry and /bbq.prep workflows",
      "mode": "primary",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "health-inspector",
          "effect": "allow"
        }
      ],
      "system": "{file:./.opencode/prompts/sous-chef.txt}"
    },
    "pitmaster": {
      "description": "Implementation and review-fix agent for /bbq.fire and /bbq.taste workflows",
      "mode": "primary",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "health-inspector",
          "effect": "allow"
        }
      ],
      "system": "{file:./.opencode/prompts/pitmaster.txt}"
    },
    "health-inspector": {
      "description": "Independent reviewer for BBQ research, plans, and implementations",
      "mode": "subagent",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status * && git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git check-ignore * || true && git log *",
          "effect": "allow"
        }
      ],
      "system": "{file:./.opencode/prompts/health-inspector.txt}"
    }
  },
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "headers": {
          "Authorization": "Bearer {env:YOUR_LINEAR_API_KEY_ENV_VAR}"
        },
        "disabled": false
      },
      "github": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:YOUR_GITHUB_PAT_ENV_VAR}"
        },
        "disabled": false
      }
    }
  }
}
